    <!-- Firebase Initialization & Main Application Logic Script -->
    <script>
        // Initialize Firebase
        const firebaseConfig = {
            databaseURL: "https://mohamed-a9564-default-rtdb.firebaseio.com/"
        };
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        } else {
            firebase.app();
        }
        const db = firebase.database();

        // State Management
        let currentUser = JSON.parse(localStorage.getItem('aurelia_current_user')) || null;
        let cart = JSON.parse(localStorage.getItem('aurelia_cart')) || [];
        let wishlist = JSON.parse(localStorage.getItem('aurelia_wishlist')) || [];
        let currentLang = 'en';

        // Default Products Seed Data
        let defaultProducts = [
            {
                id: 'prod_1',
                title: 'Crème de Lumière Diamond Necklace',
                price: 24500,
                oldPrice: 28000,
                image: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&q=80&w=800',
                timerEnd: Date.now() + 86400000 // 24 hours timer
            },
            {
                id: 'prod_2',
                title: 'Auroral Solitaire Engagement Ring',
                price: 18200,
                oldPrice: null,
                image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&q=80&w=800',
                timerEnd: null
            },
            {
                id: 'prod_3',
                title: 'Elysian Gold Diamond Bracelet',
                price: 12900,
                oldPrice: 15000,
                image: 'https://images.unsplash.com/photo-1611591475871-2ee3a6502120?auto=format&fit=crop&q=80&w=800',
                timerEnd: Date.now() + 43200000 // 12 hours timer
            }
        ];

        let products = JSON.parse(localStorage.getItem('aurelia_products')) || defaultProducts;

        // Google Drive Link Converter Utility
        function convertGoogleDriveLink(url) {
            if (!url) return '';
            if (url.includes('drive.google.com')) {
                let fileIdMatch = url.match(/\/d\/([a-zA-Z0-9_-]+)/) || url.match(/id=([a-zA-Z0-9_-]+)/);
                if (fileIdMatch && fileIdMatch[1]) {
                    return `https://lh3.googleusercontent.com/d/${fileIdMatch[1]}=s1000`;
                }
            }
            return url;
        }

        // Device Detection & Responsive UI Adjustments
        function updateDeviceDetectionSystem() {
            const width = window.innerWidth;
            document.getElementById('screen-width-val').textContent = width;
            let category = 'Desktop (1024px+)';
            let categoryKey = 'desktop';

            if (width < 640) {
                category = 'Phone / Mobile (375px - 480px)';
                categoryKey = 'mobile';
            } else if (width >= 640 && width < 1024) {
                category = 'Tablet / iPad (768px - 1024px)';
                categoryKey = 'tablet';
            }

            document.getElementById('device-category-val').textContent = category;
            document.getElementById('active-viewport-status').textContent = `ACTIVE VIEWPORT: ${category.toUpperCase()} (${width}x${window.innerHeight}px)`;
        }

        window.addEventListener('resize', updateDeviceDetectionSystem);
        window.addEventListener('DOMContentLoaded', updateDeviceDetectionSystem);

        // Render Products on Storefront
        function renderProducts() {
            const grid = document.getElementById('products-grid');
            grid.innerHTML = '';

            const isAdmin = currentUser && currentUser.name === 'Mohamed Nasser';
            if (isAdmin) {
                document.getElementById('add-product-btn').classList.remove('hidden');
                document.getElementById('admin-panel-notice').innerHTML = `
                    <div>
                        <span class="text-luxgold font-semibold uppercase tracking-wider block mb-1"><i class="fa-solid fa-shield-halved mr-1"></i> Admin Mohamed Nasser Active</span>
                        <p class="text-gray-300">Inline editing enabled: Drag resize handles, price editors, Google Drive link auto-converter, and discount countdown timers are active.</p>
                    </div>
                `;
            } else {
                document.getElementById('add-product-btn').classList.add('hidden');
            }

            products.forEach((prod, index) => {
                let timerHtml = '';
                if (prod.timerEnd && prod.timerEnd > Date.now()) {
                    const timeLeft = Math.floor((prod.timerEnd - Date.now()) / 1000);
                    const hours = Math.floor(timeLeft / 3600);
                    const mins = Math.floor((timeLeft % 3600) / 60);
                    timerHtml = `<div class="bg-luxgold/20 text-luxdark text-[10px] px-2 py-1 rounded font-semibold mb-2 flex items-center justify-between">
                        <span><i class="fa-solid fa-stopwatch mr-1"></i> Discount Timer:</span>
                        <span class="countdown-clock" data-end="${prod.timerEnd}">${hours}h ${mins}m left</span>
                    </div>`;
                }

                const card = document.createElement('div');
                card.className = 'bg-cream rounded-lg overflow-hidden shadow-sm border border-softbeige group relative';
                card.innerHTML = `
                    <div class="relative overflow-hidden aspect-square bg-gray-100">
                        <img src="${prod.image}" alt="${prod.title}" id="prod-img-${index}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 resize-handle" style="resize: both; overflow: auto;" title="Drag-to-resize handle active">
                        <button onclick="toggleWishlist('${prod.id}')" class="absolute top-3 right-3 bg-white/80 p-2 rounded-full text-luxdark hover:text-luxgold transition-colors">
                            <i class="${wishlist.includes(prod.id) ? 'fa-solid text-luxgold' : 'fa-regular'} fa-heart"></i>
                        </button>
                    </div>
                    <div class="p-5">
                        ${timerHtml}
                        <h3 class="font-serif text-lg font-bold text-luxdark mb-2">${prod.title}</h3>
                        <div class="flex items-baseline space-x-2 space-x-reverse mb-4">
                            <span class="text-luxgold font-serif font-bold text-lg">${prod.price} جنيه</span>
                            ${prod.oldPrice ? `<span class="text-gray-400 text-xs line-through">${prod.oldPrice} جنيه</span>` : ''}
                        </div>
                        
                        ${isAdmin ? `
                            <div class="mb-4 p-2 bg-softbeige/80 rounded border border-luxgold/40 text-[11px] space-y-2">
                                <span class="font-semibold text-luxgold uppercase block">Admin Inline Controls</span>
                                <input type="text" value="${prod.image}" onchange="adminUpdateImage('${prod.id}', this.value)" class="w-full bg-white border border-gray-300 p-1 text-[10px]" placeholder="Drive Image Link">
                                <input type="number" value="${prod.price}" onchange="adminUpdatePrice('${prod.id}', this.value)" class="w-full bg-white border border-gray-300 p-1 text-[10px]" placeholder="New Price EGP">
                            </div>
                        ` : ''}

                        <button onclick="addToCart('${prod.id}')" class="w-full bg-luxdark text-cream py-3 text-xs uppercase tracking-widest font-medium hover:bg-luxgold transition-all">
                            Add to Bag
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
            updateBadges();
        }

        // Cart & Wishlist Logic
        function addToCart(prodId) {
            const prod = products.find(p => p.id === prodId);
            if (!prod) return;
            cart.push(prod);
            localStorage.setItem('aurelia_cart', JSON.stringify(cart));
            updateBadges();
            openCartModal();
        }

        function toggleWishlist(prodId) {
            const index = wishlist.indexOf(prodId);
            if (index > -1) {
                wishlist.splice(index, 1);
            } else {
                wishlist.push(prodId);
            }
            localStorage.setItem('aurelia_wishlist', JSON.stringify(wishlist));
            renderProducts();
        }

        function updateBadges() {
            document.getElementById('cart-count').textContent = cart.length;
            document.getElementById('wishlist-count').textContent = wishlist.length;
        }

        // Cart Modal Actions
        document.getElementById('cart-btn').addEventListener('click', openCartModal);
        document.getElementById('close-cart').addEventListener('click', closeCartModal);

        function openCartModal() {
            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';
            let total = 0;

            if (cart.length === 0) {
                container.innerHTML = `<p class="text-xs text-gray-500 text-center py-10">Your bag is currently empty.</p>`;
            } else {
                cart.forEach((item, index) => {
                    total += Number(item.price);
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between bg-softbeige p-3 rounded';
                    div.innerHTML = `
                        <div class="flex items-center space-x-3 space-x-reverse">
                            <img src="${item.image}" class="w-12 h-12 object-cover rounded">
                            <div>
                                <h4 class="font-serif text-xs font-bold text-luxdark">${item.title}</h4>
                                <span class="text-xs text-luxgold font-semibold">${item.price} جنيه</span>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${index})" class="text-red-600 text-xs hover:underline"><i class="fa-solid fa-trash"></i></button>
                    `;
                    container.appendChild(div);
                });
            }
            document.getElementById('cart-total-price').textContent = total + ' جنيه';
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            localStorage.setItem('aurelia_cart', JSON.stringify(cart));
            openCartModal();
            updateBadges();
        }

        // Wishlist Modal Actions
        document.getElementById('wishlist-btn').addEventListener('click', () => {
            const container = document.getElementById('wishlist-items-container');
            container.innerHTML = '';
            if (wishlist.length === 0) {
                container.innerHTML = `<p class="text-xs text-gray-500 text-center py-10">Your wishlist is empty.</p>`;
            } else {
                wishlist.forEach(id => {
                    const prod = products.find(p => p.id === id);
                    if (prod) {
                        const div = document.createElement('div');
                        div.className = 'flex items-center justify-between bg-softbeige p-3 rounded';
                        div.innerHTML = `
                            <div class="flex items-center space-x-3 space-x-reverse">
                                <img src="${prod.image}" class="w-12 h-12 object-cover rounded">
                                <div>
                                    <h4 class="font-serif text-xs font-bold text-luxdark">${prod.title}</h4>
                                    <span class="text-xs text-luxgold font-semibold">${prod.price} جنيه</span>
                                </div>
                            </div>
                            <button onclick="addToCart('${prod.id}'); toggleWishlist('${prod.id}');" class="bg-luxdark text-cream px-3 py-1 text-[10px] uppercase">Add</button>
                        `;
                        container.appendChild(div);
                    }
                });
            }
            document.getElementById('wishlist-modal').classList.remove('hidden');
        });
        document.getElementById('close-wishlist').addEventListener('click', () => document.getElementById('wishlist-modal').classList.add('hidden'));
        document.getElementById('close-wishlist-bottom').addEventListener('click', () => document.getElementById('wishlist-modal').classList.add('hidden'));

        // Checkout Flow & Authentication Check
        document.getElementById('checkout-btn').addEventListener('click', () => {
            if (cart.length === 0) {
                alert('Your shopping bag is empty.');
                return;
            }
            closeCartModal();
            if (!currentUser) {
                openAuthModal('register');
            } else {
                alert(`Checkout successful! Order placed and shipping via البريد المصري to ${currentUser.address || 'Cairo'}. Thank you for shopping with AURÉLIA!`);
                cart = [];
                localStorage.setItem('aurelia_cart', JSON.stringify(cart));
                updateBadges();
            }
        });

        // Authentication Modal Management
        function openAuthModal(mode = 'login') {
            document.getElementById('auth-modal').classList.remove('hidden');
            switchAuthMode(mode);
        }

        function closeAuthModal() {
            document.getElementById('auth-modal').classList.add('hidden');
        }

        function switchAuthMode(mode) {
            document.getElementById('login-form-container').classList.add('hidden');
            document.getElementById('register-form-container').classList.add('hidden');
            document.getElementById('otp-form-container').classList.add('hidden');
            document.getElementById('address-form-container').classList.add('hidden');

            if (mode === 'login') {
                document.getElementById('login-form-container').classList.remove('hidden');
                document.getElementById('auth-title').textContent = 'Sign In to AURÉLIA';
