                document.getElementById('otp-form-container').classList.add('hidden');
                document.getElementById('address-form-container').classList.remove('hidden');
                document.getElementById('auth-title').textContent = 'Delivery Address & Shipping Notice';
                document.getElementById('auth-subtitle').textContent = 'Shipping is processed via Egypt Post (البريد المصري)';
            } else {
                alert('Invalid OTP. Please enter 5959.');
            }
        });

        // Address Form Step 3 -> Complete Registration
        document.getElementById('address-form').addEventListener('submit', (e) => {
            e.preventDefault();
            tempRegData.address = document.getElementById('user-address').value;
            tempRegData.role = 'customer';
            currentUser = tempRegData;

            localStorage.setItem('aurelia_current_user', JSON.stringify(currentUser));
            closeAuthModal();
            renderProducts();
            alert('Registration complete! Welcome to AURÉLIA.');
        });

        // User Profile Modal Actions
        document.getElementById('profile-btn').addEventListener('click', () => {
            if (!currentUser) {
                openAuthModal('login');
            } else {
                document.getElementById('profile-user-name').textContent = currentUser.name + (currentUser.role === 'admin' ? ' (Admin)' : '');
                document.getElementById('profile-phone-display').textContent = currentUser.phone || '01159055625';
                document.getElementById('profile-address-display').textContent = (currentUser.address || 'Cairo, Egypt') + ' (Shipping via البريد المصري)';
                document.getElementById('profile-modal').classList.remove('hidden');
            }
        });

        function closeProfileModal() {
            document.getElementById('profile-modal').classList.add('hidden');
        }

        function logoutUser() {
            currentUser = null;
            localStorage.removeItem('aurelia_current_user');
            closeProfileModal();
            renderProducts();
            alert('Signed out successfully.');
        }

        function triggerPhoneUpdate() {
            const newPhone = prompt('Enter new phone number (triggers WhatsApp OTP flow):', currentUser.phone);
            if (newPhone) {
                currentUser.phone = newPhone;
                localStorage.setItem('aurelia_current_user', JSON.stringify(currentUser));
                alert(`WhatsApp OTP sent from 01159055625 to ${newPhone}. Verified successfully!`);
                document.getElementById('profile-phone-display').textContent = newPhone;
            }
        }

        // Admin Inline Editing Functions
        function adminUpdateImage(prodId, rawUrl) {
            const prod = products.find(p => p.id === prodId);
            if (prod) {
                prod.image = convertGoogleDriveLink(rawUrl);
                localStorage.setItem('aurelia_products', JSON.stringify(products));
                renderProducts();
            }
        }

        function adminUpdatePrice(prodId, newPrice) {
            const prod = products.find(p => p.id === prodId);
            if (prod) {
                prod.price = Number(newPrice);
                localStorage.setItem('aurelia_products', JSON.stringify(products));
                renderProducts();
            }
        }

        document.getElementById('add-product-btn').addEventListener('click', () => {
            document.getElementById('admin-product-modal').classList.remove('hidden');
        });

        function closeAdminProductModal() {
            document.getElementById('admin-product-modal').classList.add('hidden');
        }

        document.getElementById('admin-product-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const title = document.getElementById('new-prod-title').value;
            const price = Number(document.getElementById('new-prod-price').value);
            const rawImg = document.getElementById('new-prod-img').value;

            const newProd = {
                id: 'prod_' + Date.now(),
                title: title,
                price: price,
                oldPrice: price + 3000,
                image: convertGoogleDriveLink(rawImg),
                timerEnd: Date.now() + 86400000
            };

            products.push(newProd);
            localStorage.setItem('aurelia_products', JSON.stringify(products));
            closeAdminProductModal();
            renderProducts();
        });

        // Mobile Menu Toggle
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            const drawer = document.getElementById('mobile-menu-drawer');
            menu.classList.remove('hidden');
            setTimeout(() => {
                menu.classList.remove('opacity-0');
                drawer.classList.remove('-translate-x-full');
            }, 10);
        });

        document.getElementById('close-mobile-menu').addEventListener('click', closeMobileDrawer);
        document.getElementById('mobile-menu').addEventListener('click', (e) => {
            if (e.target === document.getElementById('mobile-menu')) closeMobileDrawer();
        });

        function closeMobileDrawer() {
            const menu = document.getElementById('mobile-menu');
            const drawer = document.getElementById('mobile-menu-drawer');
            menu.classList.add('opacity-0');
            drawer.classList.add('-translate-x-full');
            setTimeout(() => menu.classList.add('hidden'), 300);
        }

        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', closeMobileDrawer);
        });

        // Language Toggle (EN / AR RTL)
        document.getElementById('lang-toggle').addEventListener('click', () => {
            currentLang = currentLang === 'en' ? 'ar' : 'en';
            const htmlTag = document.documentElement;
            if (currentLang === 'ar') {
                htmlTag.setAttribute('lang', 'ar');
                htmlTag.setAttribute('dir', 'rtl');
                document.getElementById('announcement-text').textContent = 'شحن مجاني لكافة أنحاء مصر عبر البريد المصري | مجوهرات راقية حصرية';
            } else {
                htmlTag.setAttribute('lang', 'en');
                htmlTag.setAttribute('dir', 'ltr');
                document.getElementById('announcement-text').textContent = 'Complimentary Shipping Across Egypt via البريد المصري | Exclusive Fine Jewelry';
            }
        });

        // Initial render on load
        renderProducts();
    </script>
</body>
</html>
