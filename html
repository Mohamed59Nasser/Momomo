            } else if (mode === 'register') {
                document.getElementById('register-form-container').classList.remove('hidden');
                document.getElementById('auth-title').textContent = 'Create Account';
                document.getElementById('auth-subtitle').textContent = 'Verification via WhatsApp from 01159055625';
            }
        }

        // Login Handler (Supports Default Admin: Mohamed Nasser / Mohamed59*)
        document.getElementById('login-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim();
            const pass = document.getElementById('login-password').value.trim();

            if (email === 'Mohamed Nasser' && pass === 'Mohamed59*') {
                currentUser = { name: 'Mohamed Nasser', role: 'admin', phone: '01159055625', address: 'Cairo, Egypt' };
            } else {
                currentUser = { name: email, role: 'customer', phone: '01000000000', address: 'Cairo, Egypt' };
            }

            localStorage.setItem('aurelia_current_user', JSON.stringify(currentUser));
            closeAuthModal();
            renderProducts();
            alert(`Welcome back, ${currentUser.name}!`);
